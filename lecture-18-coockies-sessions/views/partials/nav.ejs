<header>
  <nav class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

      <!-- Logo / Home -->
      <a href="/" class="text-xl font-bold text-rose-600">
        Airbnb
      </a>

      <!-- Navigation Links -->
      <div class="flex items-center gap-6">
        <a href="/" class="<%= currentPage === 'index'
     ? 'text-red-800 font-medium'
     : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
          airbnb
        </a>

        <% (isLoggedIn) { %>

          <a href="/homes" class="<%= currentPage === 'Home' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
            Home-list
          </a>

          <a href="/favourites" class="<%= currentPage === 'favourite' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
            Favourite
          </a>

          <a href="/bookings" class="<%= currentPage === 'bookings' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
            Bookings
          </a>

          <a href="/host/host-home-list" class="<%= currentPage === 'host-homes' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
            Host Home
          </a>

          <a href="/host/add-home" class="<%= currentPage === 'addHome' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
            Add Your Home
          </a>
        <% } %>

        <a href="/login" class="hover:text-rose-600 border border-transparent rounded-md p-1 hover:border-rose-600 font-medium transition <%= currentPage === 'login' ? 'text-red-800 font-medium' : 'text-gray-700 hover:text-rose-600 font-medium transition' %>">
          Login
        </a>
        
      </div>

    </div>
  </nav>

</header>
