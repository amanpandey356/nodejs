<%- include('../partials/head') %>

<body class="min-h-screen bg-[#F7F7F7] text-[#222222]">
  <%- include('../partials/nav') %>

  <main class="flex min-h-[calc(100vh-65px)] items-center justify-center px-4 py-8">
    <section class="w-full max-w-md rounded-xl border border-gray-200 bg-white px-6 py-8 shadow-lg sm:px-8">

      <!-- Heading -->
      <div class="mb-7 text-center">
        <h1 class="text-2xl font-bold tracking-tight text-[#222222]">
          Create your account
        </h1>

        <p class="mt-2 text-sm text-gray-500">
          Join us and get started today.
        </p>
      </div>

      <%- include("../partials/errors") %>

      <form action="/signup" method="POST" class="space-y-4">

        <!-- First name and last name -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="firstName" class="mb-1.5 block text-sm font-medium">
              First name
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              placeholder="First name"
              autocomplete="given-name"
              value="<%= oldInput && oldInput.firstName ? oldInput.firstName : '' %>"
              required
              class="w-full rounded-lg border border-gray-300 px-3 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
            />
          </div>

          <div>
            <label for="lastName" class="mb-1.5 block text-sm font-medium">
              Last name
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              placeholder="Last name"
              autocomplete="family-name"
              value="<%= oldInput && oldInput.lastName ? oldInput.lastName : '' %>"
              required
              class="w-full rounded-lg border border-gray-300 px-3 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">
            Email address
          </label>

          <input
            type="email"
            id="email"
            name="email"
            value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
            placeholder="Enter your email"
            autocomplete="email"
            required
            class="w-full rounded-lg border border-gray-300 px-3 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
          />
        </div>

        <!-- User Type -->
        <div>
          <label for="userType" class="mb-1.5 block text-sm font-medium">
            I want to join as
          </label>

          <select
            id="userType"
            name="userType"
            required
            value="<%= oldInput && oldInput.userType ? oldInput.userType : '' %>"
            class="w-full rounded-lg border border-gray-300 bg-white px-3 py-3 text-sm text-[#222222] outline-none transition focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
          >
            <option value="" disabled selected>Select account type</option>
            <option value="guest">Guest</option>
            <option value="host">Host</option>
          </select>
        </div>

        <!-- Password -->
        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium">
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            value="<%= oldInput && oldInput.password ? oldInput.password : '' %>"
            placeholder="Create a password"
            autocomplete="new-password"
            minlength="8"
            required
            class="w-full rounded-lg border border-gray-300 px-3 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
          />

          <p class="mt-1.5 text-xs text-gray-500">
            Use at least 8 characters.
          </p>
        </div>

        <!-- Confirm password -->
        <div>
          <label for="confirmPassword" class="mb-1.5 block text-sm font-medium">
            Confirm password
          </label>

          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            placeholder="Re-enter your password"
            autocomplete="new-password"
            minlength="8"
            required
            class="w-full rounded-lg border border-gray-300 px-3 py-3 text-sm outline-none transition placeholder:text-gray-400 focus:border-[#FF385C] focus:ring-1 focus:ring-[#FF385C]"
          />
        </div>

        <!-- Terms and conditions -->
        <div class="flex items-start gap-2.5 pt-1">
          <input
            type="checkbox"
            id="terms"
            name="terms"
            value="accepted"
            required
            class="mt-1 h-4 w-4 shrink-0 cursor-pointer accent-[#FF385C]"
          />

          <label for="terms" class="text-sm leading-5 text-gray-600">
            I agree to the
            <a href="/terms" class="font-medium text-[#E31C5F] underline underline-offset-2">
              Terms and Conditions
            </a>
            and
            <a href="/privacy" class="font-medium text-[#E31C5F] underline underline-offset-2">
              Privacy Policy
            </a>.
          </label>
        </div>

        <!-- Submit button -->
        <button
          type="submit"
          class="w-full rounded-lg bg-[#FF385C] px-4 py-3 text-sm font-semibold text-white transition hover:bg-[#E31C5F] focus:outline-none focus:ring-2 focus:ring-[#FF385C] focus:ring-offset-2 active:scale-[0.99]"
          action="/signup" method="POST"
        >
          Create account
        </button>

        <!-- Login link -->
        <div class="border-t border-gray-200 pt-4 text-center">
          <p class="text-sm text-gray-600">
            Already have an account?
            <a
              href="/login"
              class="font-semibold text-[#E31C5F] hover:underline"
            >
              Log in
            </a>
          </p>
        </div>

      </form>
    </section>
  </main>
</body>
